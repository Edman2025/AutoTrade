# Copy to market-maker.production.env with mode 0600. Never commit the real file.
SOLANA_RPC_URL=https://your-authenticated-private-rpc.example
MAKER_RPC_PROVIDER=reviewed-provider-name
MAKER_RPC_SLA_ACK=I_VERIFIED_PRIVATE_RPC_SLA
# Temporary fallback only: leave unset when using the private RPC policy above.
# MAKER_PUBLIC_RPC_LIVE_ACK=I_ACCEPT_PUBLIC_RPC_LIVE_RISK
MAKER_SNAPSHOT_INTERVAL_MS=30000
MAKER_QUOTE_STALE_MS=30000
# Production override: retain at least 0.01 SOL for fees; raise this when treasury funding permits.
MAKER_MIN_SOL_RESERVE_RAW=10000000
MAKER_MODE=prepare
MAKER_LIVE_ACK=
MAKER_WALLET_ADDRESS=your-solana-public-address
MAKER_ADMIN_TOKEN=generate-at-least-32-random-characters
MAKER_HOST=0.0.0.0
MAKER_PORT=8788
MAKER_ALLOWED_ORIGINS=https://agent-trade.xunlian.co
MAKER_DATABASE_PATH=services/market-maker/data/maker.sqlite
MAKER_SNAPSHOT_INTERVAL_MS=10000
MAKER_QUOTE_STALE_MS=30000
MAKER_ACCOUNTING_TIME_ZONE=Asia/Shanghai
MAKER_ENABLE_POSITION_INDEX=true
MAKER_INVENTORY_TARGET_BG_BPS=4500
MAKER_INVENTORY_TARGET_ANTFUN_BPS=1000
MAKER_INVENTORY_TARGET_USDT_BPS=4500
MAKER_INVENTORY_TOLERANCE_BPS=500
