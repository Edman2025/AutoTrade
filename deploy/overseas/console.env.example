# Safe template defaults. Production live acknowledgements and the administrator
# token stay only in the root-owned /etc/siam-console.env file.
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
SOLANA_INDEXER_RPC_URL=https://api.mainnet-beta.solana.com
MAKER_MODE=observe
MAKER_HOST=127.0.0.1
MAKER_PORT=8788
MAKER_ALLOWED_ORIGINS=https://console.xianluobi.com
MAKER_DATABASE_PATH=/var/lib/siam-console/maker.sqlite
MAKER_WALLET_ADDRESS=EVMviog49Q1iniaV54JpXiXWwJ3KxbVUXVBFkX8z26Ms
MAKER_ENABLE_POSITION_INDEX=false
MAKER_SNAPSHOT_INTERVAL_MS=30000
MAKER_QUOTE_STALE_MS=30000
MAKER_TOKEN_HOLDER_REFRESH_MS=300000
MAKER_TOKEN_ACTIVITY_REFRESH_MS=30000
MAKER_TOKEN_ACTIVITY_LIMIT=40
MAKER_TOKEN_ACTIVITY_PARSE_BATCH=8
MAKER_ACCOUNTING_TIME_ZONE=Asia/Shanghai

MAKER_TRUST_LOOPBACK_PROXY=true
