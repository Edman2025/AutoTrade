FROM node:24-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json ./
COPY vendor ./vendor
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && test ! -e node_modules/bigint-buffer/build/Release/bigint_buffer.node \
    && npm cache clean --force
COPY services/market-maker ./services/market-maker
COPY scripts/backup-market-maker-db.mjs scripts/backup-market-maker-loop.mjs scripts/verify-dependency-mitigations.mjs ./scripts/

USER 1001:1001
ENTRYPOINT ["node"]
CMD ["services/market-maker/server.mjs"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8788/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
