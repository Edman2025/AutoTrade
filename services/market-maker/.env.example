# Read-only is the only safe default.
MAKER_MODE=observe
# Solana Labs official public mainnet RPC. Replace with a dedicated provider before production.
SOLANA_RPC_URL=https://api.mainnet.solana.com
MAKER_HOST=127.0.0.1
MAKER_PORT=8788
MAKER_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Public addresses only. Never put a seed phrase or private key in this file.
MAKER_WALLET_ADDRESS=
MAKER_ENABLE_POSITION_INDEX=false

# Required only for prepare/live mutation endpoints. Use at least 32 random characters.
MAKER_ADMIN_TOKEN=

# Live remains blocked unless this exact acknowledgement is set and all risk gates pass.
MAKER_LIVE_ACK=

MAKER_SNAPSHOT_INTERVAL_MS=10000
MAKER_QUOTE_STALE_MS=3000
MAKER_MAX_SLIPPAGE_BPS=100
MAKER_MAX_PRICE_IMPACT_BPS=100
MAKER_MAX_TRADE_BG_RAW=1000000000000
MAKER_MAX_TRADE_ANTFUN_RAW=4000000000
MAKER_MAX_TRADE_USDT_RAW=2000000000
MAKER_MAX_DAILY_NOTIONAL_USDT_RAW=10000000000
MAKER_MIN_SOL_RESERVE_RAW=100000000
MAKER_MAX_CONSECUTIVE_FAILURES=3
MAKER_COOLDOWN_MS=30000
MAKER_DAILY_LOSS_LIMIT_BPS=300
